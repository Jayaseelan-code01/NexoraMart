digraph ER {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.8];
  node [shape=record, fontname="Arial", fontsize=10, style="rounded,filled", fillcolor="#EEF5FF", color="#355C9A"];
  edge [color="#4A5568"];
  users [label="{users|id PK\lname\lemail UNIQUE\lpassword_hash\lrole\lactive\lcreated_at}"];
  products [label="{products|id PK\lseller_id FK\lname\lbrand / model\lprice DECIMAL\lstock_qty\lcategory\lspecifications\limage_url_1..3\lactive\lcreated_at}"];
  orders [label="{orders|id PK\lorder_ref UNIQUE\lbuyer_id FK\ltotal_amount DECIMAL\lstatus\lcreated_at}"];
  order_items [label="{order_items|id PK\lorder_id FK\lproduct_id FK\lproduct_name\lunit_price\lquantity}"];
  reviews [label="{reviews|id PK\lbuyer_id FK\lproduct_id FK\lrating 1..5\lcomment\lseller_reply\lcreated_at}"];
  audit [label="{audit_logs|id PK\lactor_user_id FK\laction\lentity_type\lentity_id\ldetails\lcreated_at}"];
  users -> products [label="seller"];
  users -> orders [label="buyer"];
  orders -> order_items [label="1..*"];
  products -> order_items [label="1..*"];
  users -> reviews [label="writes"];
  products -> reviews [label="receives"];
  users -> audit [label="actor"];
}
