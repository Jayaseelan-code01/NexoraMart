<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Create Account · NexoraMart</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body><main class="auth"><div class="auth-card"><a href="<%=request.getContextPath()%>/marketplace">← Marketplace</a><h1>Create account</h1><% if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><form method="post"><label>Name</label><input name="name" required><label>Email</label><input name="email" type="email" required><label>Password</label><input name="password" type="password" minlength="6" required><label>Role</label><select name="role" required><option value="">Choose</option><option value="BUYER">Buyer</option><option value="SELLER">Seller</option></select><button>Create Account</button></form><p>Already registered? <a href="<%=request.getContextPath()%>/login">Login</a></p></div></main><script src="<%=request.getContextPath()%>/js/theme.js"></script>
</body></html>
