<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
 <display-name>NexoraMart</display-name>
 <listener><listener-class>com.jayaseelan.nexoramart.listener.DatabaseListener</listener-class></listener>
 <filter><filter-name>SecurityHeaders</filter-name><filter-class>com.jayaseelan.nexoramart.filter.SecurityHeadersFilter</filter-class></filter>
 <filter-mapping><filter-name>SecurityHeaders</filter-name><url-pattern>/*</url-pattern></filter-mapping>
 <session-config><session-timeout>30</session-timeout></session-config>
 <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
 <error-page><error-code>404</error-code><location>/WEB-INF/views/error/404.jsp</location></error-page>
 <error-page><error-code>500</error-code><location>/WEB-INF/views/error/500.jsp</location></error-page>
</web-app>
